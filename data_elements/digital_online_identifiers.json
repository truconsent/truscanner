    "sources": [
        {
            "name": "IP Address",
            "category": "Digital & Online Identifiers",
            "patterns": [
                "\\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\b",
                "\\b(?:[A-Fa-f0-9]{1,4}:){2,7}[A-Fa-f0-9]{1,4}\\b",
                "(?i)\\bip[^\\s/(;)#|,=!>]{0,5}address\\b",
                "(?i)\\bip[-_\\s]{0,2}address\\b"
            ],
            "tags": {
                "sensitivity": "medium"
            }
        },
        {
            "name": "Device ID",
            "category": "Digital & Online Identifiers",
            "patterns": [
                "(?i)\\bdevice\\b"
            ],
            "tags": {
                "sensitivity": "medium"
            }
        },
        {
